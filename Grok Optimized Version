local function createRockV2(name, cf, size)
    local enabled, connection, charAddedConnection, diedConnection
    local function getRoot()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        return character:WaitForChild("HumanoidRootPart")
    end
    local function pressKey(keyCode)
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end
    local function forceEquipPunch()
        local character, backpack = LocalPlayer.Character, LocalPlayer.Backpack
        if not character or not backpack then return false end
        local punch = backpack:FindFirstChild("Punch") or character:FindFirstChild("Punch")
        if punch then
            if punch.Parent \~= character then punch.Parent = character end
            local attackTime = punch:FindFirstChild("attackTime")
            if attackTime then attackTime.Value = 0 end
            return true
        end
        return false
    end
    local function startAutoPunch()
        _G.fastHitActive = true
        task.spawn(function()
            while _G.fastHitActive do forceEquipPunch() task.wait(0.05) end
        end)
        task.spawn(function()
            while _G.fastHitActive do
                local punch = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Punch")
                if punch then punch:Activate() end
                task.wait(0.1)
            end
        end)
        local function hookDied(char)
            local humanoid = char:WaitForChild("Humanoid", 5)
            if humanoid then
                if diedConnection then diedConnection:Disconnect() end
                diedConnection = humanoid.Died:Connect(function() end)
            end
        end
        if LocalPlayer.Character then hookDied(LocalPlayer.Character) end
        if charAddedConnection then charAddedConnection:Disconnect() end
        charAddedConnection = LocalPlayer.CharacterAdded:Connect(function(char)
            hookDied(char)
            task.spawn(function()
                task.wait(0.4)
                if _G.fastHitActive then pressKey(Enum.KeyCode.One) end
                for i = 1, 40 do
                    if not _G.fastHitActive then break end
                    if forceEquipPunch() then break end
                    task.wait(0.1)
                end
            end)
        end)
    end
    local function stopAutoPunch()
        _G.fastHitActive = false
        if charAddedConnection then charAddedConnection:Disconnect() charAddedConnection = nil end
        if diedConnection then diedConnection:Disconnect() diedConnection = nil end
        local punch = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Punch")
        if punch then punch.Parent = LocalPlayer.Backpack end
    end
    rockington2:AddSwitch(name, function(state)
        enabled = state
        if enabled then
            pcall(function() ReplicatedStorage.rEvents.changeSpeedSizeRemote:InvokeServer("changeSize", size or 12) end)
            if connection then connection:Disconnect() end
            connection = RunService.Heartbeat:Connect(function()
                local root = getRoot()
                if root then
                    root.CFrame = cf
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end)
            startAutoPunch()
        else
            if connection then connection:Disconnect() connection = nil end
            local root = getRoot()
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            pcall(function() ReplicatedStorage.rEvents.changeSpeedSizeRemote:InvokeServer("changeSize", 1) end)
            stopAutoPunch()
        end
    end)
end

