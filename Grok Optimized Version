                        local evil = target:FindFirstChild("evilKarma")
                        local good = target:FindFirstChild("goodKarma")
                        if evil and good and evil:IsA("IntValue") and good:IsA("IntValue") then
                            local condition = isGood and (evil.Value > good.Value) or (good.Value > evil.Value)
